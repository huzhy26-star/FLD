  #   lw <- nb2listw(nb_list, style = "B", zero.policy = TRUE) # 分类变量建议用 Binary 权重
  #   
  #   # 4. 计算莫兰指数
  #   # 使用 moran.mc (蒙特卡洛模拟) 对 0/1 变量更稳健，或者直接用 moran.test
  #   m_test <- moran.test(vals, lw, zero.policy = TRUE, alternative = "greater")
  #   
  #   return(data.frame(
  #     Group = target_group,
  #     Moran_I = m_test$estimate[1],
  #     P_value = m_test$p.value,
  #     Observed = m_test$estimate[1],
  #     Expected = m_test$estimate[2],
  #     Statistic = m_test$statistic
  #   ))
  # }
  # 
  # # 5. 循环计算所有标签的聚集程度
  # all_groups <- unique(df$Liver_zone)
  # cluster_results <- map_df(all_groups, ~calc_label_clustering(df, .x))
  # 
  # print(cluster_results)
  
  
  
  df <- obj@meta.data %>% dplyr::select(c(Liver_zone,row,col))
  # 1. 准备权重矩阵 (对全量数据建立)
  coords <- as.matrix(df[, c("row", "col")])
  nn <- nn2(coords, k = 11)
  nb_list <- lapply(1:nrow(nn$nn.idx), function(i) nn$nn.idx[i, -1])
  class(nb_list) <- "nb"
  lw <- nb2listw(nb_list, style = "B") # 采用 Binary 权重
  
  # 2. 计算各组的 Moran's I
  all_groups <- unique(df$Liver_zone)
  group_stats <- map_df(all_groups, function(g){
    vals <- if_else(df$Liver_zone == g, 1, 0)
    m_test <- moran.test(vals, lw, zero.policy = TRUE)
    data.frame(
      Liver_zone = g,
      Count = sum(vals),
      Moran_I = m_test$estimate[1],
      P_val = m_test$p.value
    )
  })
  
  # 3. 计算综合全局指数 (Global Weighted Index)
  # 使用各组点数占比作为权重进行加权平均
  global_combined_index <- sum(group_stats$Moran_I * group_stats$Count) / sum(group_stats$Count)
  
  print(group_stats)
  cat("综合全局莫兰指数为:", global_combined_index)
  moran_index <- c(global_combined_index,moran_index)
}

