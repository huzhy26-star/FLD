obj_ST <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/ST/RDS_大类/merged_rds.rds")
ncol(obj_ST)
Idents(obj_ST) <- "sample"
allCells=names(Idents(obj_ST))
allType = levels(Idents(obj_ST))
choose_Cells = unlist(lapply(allType, function(x){
  cgCells = allCells[Idents(obj_ST)== x ]
  cg=sample(cgCells,round(length(cgCells)*0.1,digits = 0)) #按10%抽样
  cg
}))
cg_sce = obj_ST[, allCells %in% choose_Cells]


unique(cg_sce$sample)
cg_sce@meta.data$sample <- as.character(cg_sce@meta.data$sample)
cg_sce@meta.data$sample[cg_sce@meta.data$sample %in% c("ND")] <- "normal"
table(cg_sce@meta.data$sample)
matrix<-as.matrix(cg_sce@assays$Spatial@counts)

cg_sce@meta.data$barcode <- rownames(cg_sce@meta.data)
ann <- cg_sce@meta.data[,c("sample","barcode")]
ann <- as.matrix(ann)
gene.order <- read.table("/data02/liuxiaofei_2/GIST/GIST/2023.3.20/infercnv/output_positional.txt")
head(matrix)[1:5,1:5]
