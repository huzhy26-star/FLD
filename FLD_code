my_dist2list <- function(dist.obj) {
  dist_mat <- as.matrix(dist.obj)
  diag(dist_mat) <- NA # 将对角线设为NA，之后方便过滤掉
  return(as.data.frame(as.table(dist_mat), responseName = "value", na.rm = TRUE))
}
remaining_types <- c("Myeloid")
specified_types <- c("HSC")  ###中心细胞

obj_merged <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/ST/RDS_大类/merged_rds.rds")
meta_all <- obj_merged@meta.data
sample_list <- unique(meta_all$sample)
sample_dis <- list()
results_list <- list()
for (samplename in sample_list) {
  print(samplename)
  cur_meta_inuse <- subset(meta_all, sample == samplename)
  
  all_cell_coords <- cur_meta_inuse[, c("row", "col")]
  all_cell_types <- cur_meta_inuse$celltype
  
  for (spec_type in specified_types) {
    print(spec_type)
    
    specified_cells <- which(all_cell_types == spec_type)
    specified_names <- rownames(cur_meta_inuse)[specified_cells]
    specified_coords <- all_cell_coords[specified_cells, ]
    
    type_results <- vector("list", length(remaining_types))
    
    for (j in seq_along(remaining_types)) {
      remain_type <- remaining_types[j]
      remaining_cells <- which(all_cell_types == remain_type)
      
      if (length(specified_cells) > 0 && length(remaining_cells) > 0) {
        remaining_coords <- all_cell_coords[remaining_cells, ]
        avg_dists_top5 <- sapply(1:nrow(specified_coords), function(i) {
          dists <- sqrt((specified_coords[i, 1] - remaining_coords[, 1])^2 + 
                          (specified_coords[i, 2] - remaining_coords[, 2])^2)
          k <- min(3, length(dists))
          mean(sort(dists)[1:k])
        })
        
        type_results[[j]] <- data.frame(
          cell = specified_names,
          avg_distance_top3 = avg_dists_top5,
          source_type = spec_type,
          target_type = remain_type,
          samplename = samplename
        )
      }
    }
    
    results_list[[spec_type]] <- do.call(rbind, type_results)
  }
  final_result_df <- do.call(rbind, results_list)
  sample_dis[[samplename]] <- final_result_df
}

