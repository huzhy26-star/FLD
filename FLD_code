s_inner <- function(r, R = 10){
  h  = R/2 * sqrt(3) 
  if(r < h){
    s = r^2 * pi
  }
  if (r == R){
    s = 3/2 * sqrt(3) * R^2
  }
  if (h < r & r< R){
    theta <- 2*acos(h/r)
    s <- r^2 * pi - 3 * r^2 * (theta - sin(theta))
  }
  return(s)
}

prob_data <- data.frame(1,1)
