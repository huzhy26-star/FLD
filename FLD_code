get_earliest_principal_node <- function(cds, time_bin="CD8_Tn"){
  cell_ids <- which(colData(cds)[, "Minor_celltype"] == time_bin)
  
  closest_vertex <-
    cds@principal_graph_aux[["UMAP"]]$pr_graph_cell_proj_closest_vertex
