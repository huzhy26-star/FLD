for(n in 1:9){
  s1 <- s_inner(r=n)
  s2 <- s_inner(r=n+1)
  s_layer <- s2 - s1
  s_layer_data <- data.frame(n,s_layer)
  colnames(s_layer_data) <- c("layer","area")
  prob_data <- rbind(prob_data, s_layer_data)
}
