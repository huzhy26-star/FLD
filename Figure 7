  )
)
Idents(HSC) <- "subtype"
DEG <- FindAllMarkers(HSC %>% subset(time == "16w"), only.pos = T, min.pct = 0.25, logfc.threshold = 0.25)

stage = "16w"
for (cell in unique(HSC$subtype)) {
  genelist <- DEG %>% filter(cluster == cell) %>% 
    filter(p_val < 0.05 & avg_log2FC > 0.25) %>% pull(gene)
  gene_symbol <- bitr(genelist, fromType="SYMBOL", toType="ENTREZID", OrgDb="org.Mm.eg.db")
  
  GO_enrich=enrichGO(gene = gene_symbol$ENTREZID,
                     OrgDb = org.Mm.eg.db,
                     pvalueCutoff =1,
                     qvalueCutoff = 1,
                     ont="all",
                     readable =T)	
  GO_enrich=as.data.frame(GO_enrich)
  
  KEGG_enrich <- enrichKEGG(gene = gene_symbol$ENTREZID,keyType="kegg",
                            pAdjustMethod="none",
                            organism = "mouse",
                            qvalueCutoff = 1, pvalueCutoff=1)
  KEGG_enrich = as.data.frame(KEGG_enrich)
  genelist <- strsplit(KEGG_enrich$geneID,"/")
  KEGG_enrich$geneID <- lapply(genelist, changename) %>% unlist()
  
  p <- GO_KEGG_plot(go = GO_enrich, kegg =KEGG_enrich, go_ontology = c("BP"),show_n = 10, title = glue("{cell} {stage} stage"),
                    color = brewer.pal(4, "Accent"))
  
  write.csv(GO_enrich, glue("{result_path}/GO_{cell}_{stage}.csv"))
  write.csv(KEGG_enrich,glue("{result_path}/KEGG_{cell}_{stage}.csv"))
  save_plot(p, prefix = glue("{result_path}/pathway_{cell}_{stage}"), if_pdf = T, height = 10,width = 10)
  
  ##
  df_pathway <- GO_enrich %>% filter(ONTOLOGY %in% "BP") %>% 
    mutate(logq = -log10(qvalue)) %>% arrange(desc(Count),desc(logq)) %>% 
    head(n = 10) 
  
  df_pathway$GeneRatioDraw <- lapply(df_pathway$GeneRatio, function(x){
    g <- strsplit(x, "/")[[1]] %>% as.numeric()
    g <- g[1]/g[2]
    g <- round(g, 3)
    return(g)
  }) %>% unlist()
  
  
  p <- ggplot(df_pathway, aes(x = GeneRatioDraw,
                              y = reorder(Description, GeneRatioDraw)
  ))+
    geom_point(aes(size= Count, color = logq))+
    guides(size=guide_legend(override.aes=list(shape=21, colour="black", fill="white"))) +
    scale_color_gradientn(colours = viridis::viridis(256)) +
    labs(
      size="Gene counts",color="-log10(p-value)",x="Gene Ratio"
    )+
    theme_bw()+
    theme(
      axis.text.y = element_text(size = rel(1.5), color = "black"),
      # axis.text.x = element_blank(),
      axis.title.x = element_text(size= rel(1.5)),
      axis.title.y = element_blank(),
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank()
    )+
    scale_size(range=c(5, 10))+
    ggtitle(glue("{cell} {stage} stage"))
  p
  save_plot(p, glue("{result_path}/dotplot_GO_{cell}_{stage}"), width = 11, height = 6, if_pdf = T)
}

