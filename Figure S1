##Fig.S1B####
p_list <- list()
for (cur_d in c("ALT","AST","Liver TG","TG","Liver TNF","Tnf",
                "IL-1b","IL-6","TGFb","Col1a1","Acna2","Timp")) {
  df <- readxl::read_xlsx("/Users/huzhiyang/Desktop/脂肪肝/result/FLD_serum.xlsx",sheet = cur_d)
  df_prop <- reshape2::melt(df) 
  df_prop$variable <- as.character(df_prop$variable)
  colnames(df_prop)[1] <- "group"
  
  df_filter <- filter(df_prop, group %in% c("ND","WD-4wks","WD-8wks","WD-12wks","WD-16wks","WD-20wks","WD-24wks","WD-36wks"))
  
  
  df_plot1 <- df_filter %>%
    group_by(group) %>%
    summarize(Value = mean(value), SD = sd(value), .groups = "drop")
  
  df_filter$group <- factor(df_filter$group,levels = c("ND","WD-4wks","WD-8wks","WD-12wks","WD-16wks","WD-20wks","WD-24wks","WD-36wks"))
  df_plot1$group <- factor(df_plot1$group,levels = c("ND","WD-4wks","WD-8wks","WD-12wks","WD-16wks","WD-20wks","WD-24wks","WD-36wks"))
  
  comparisons = list(c("ND","WD-4wks"),c("WD-4wks","WD-8wks"),c("WD-8wks","WD-12wks"),c("WD-12wks","WD-16wks"),c("WD-16wks","WD-20wks"),c("WD-20wks","WD-24wks"),c("WD-24wks","WD-36wks"))
  p1 <- ggplot(data =df_filter , aes(x = group, y = value)) +
    geom_bar(data =df_plot1, aes(x = group, y = Value, fill = group),
             stat = "identity", width = 0.6, alpha = 0.6) +  # 1. 绘制柱状图  透明度设置为0.6
    geom_errorbar(data = df_plot1, aes(x = group, y = Value,ymin = Value - SD, ymax = Value + SD),
                  width = 0.2, size = 0.8, color = "black") +# 2. 添加误差线
    geom_jitter(data = df_filter, aes(x = group, y = value, color = group),
                width = 0.2, size = 2, alpha = 0.8) +  #3. 添加散点（个体样本）  轻微抖动防止重叠
    stat_compare_means(comparisons=comparisons, label="p.format",method = 'wilcox.test',size = 2,step.increase = 0.04) +
    labs(title = cur_d,
         x = "",
         y = "") +# 4. 调整主题和标签
    scale_fill_manual(values = FLD_col) + # 自定义填充色
    scale_color_manual(values = FLD_col)+  # 自定义散点颜色
    theme(
      plot.title    = element_text(color = 'black', size   = 12, hjust = 0.5,face = "bold"),
      plot.subtitle = element_text(color = 'black', size   = 8,hjust = 0.5),
      plot.caption  = element_text(color = 'black', size   = 8,face = 'italic', hjust = 1),
      axis.text.x   = element_text(color = 'black', size = 8, angle = 30,hjust = 1,vjust = 1,face = "bold"),#
      axis.text.y   = element_text(color = 'black', size = 10, angle = 0),
      axis.title.x  = element_text(color = 'black', size = 14, angle = 0),
      axis.title.y  = element_text(color = 'black', size = 14, angle = 90),
      legend.title  = element_text(color = 'black', size  = 12),
      legend.text   = element_text(color = 'black', size   = 8),
      # axis.line.y = element_line(color = 'black', linetype = 'solid'), # y轴线特征
      # axis.line.x = element_line (color = 'black',linetype = 'solid'), # x轴线特征
      panel.background=element_rect(fill="white"), 
      panel.border = element_rect(linetype = 'solid', size = 1,fill = NA) # 图四周框起来
    )
  p_list[[cur_d]] <- p1
  # save_plot(p1, glue("/Users/huzhiyang/Desktop/脂肪肝/result/FLD_serum_恢复模型/{cur_d}_R"),if_pdf = T,width = 5.5,height = 4)
}
save_plot(wrap_plots(p_list, ncol = 3), glue("/Users/huzhiyang/Desktop/脂肪肝/result/FLD_serum/merge_2"),if_pdf = T,width = 18,height = 15)

