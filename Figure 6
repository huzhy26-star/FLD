#permanova_analysis
library(vegan)
library(tidyverse)
pc_data <- as.data.frame(pca_res$x)#提取pca分析所有pc轴
Group <- c("ND_36W", "ND_36W", "ND_36W", "ND_36W", "ND_36W",
           "WD_ND_8W","WD_ND_8W","WD_ND_8W","WD_ND_8W","WD_ND_8W")
Group <- factor(Group)
#计算距离矩阵
# 在PC空间中，通常使用欧氏距离
dist_matrix <- vegdist(pc_data, method = "euclidean")#用原始数据分析需将pc_data改为t(log2(exp_gene+1))
#执行PERMANOVA（整体检验）
set.seed(123)  # 设置随机种子，保证结果可重复
permanova_result <- adonis2(dist_matrix ~ Group, permutations = 999)
print(permanova_result)

# 输出结果中的 Pr(>F) 即为P值，若 < 0.05 则说明组间有显著差异

#检验多元离散度（PERMDISP）
# 用于检查是否满足“多元齐性”假设，若显著则需谨慎解释PERMANOVA结果
dispersal_result <- betadisper(dist_matrix, Group)
permdisp_test <- permutest(dispersal_result, permutations = 999)
print(permdisp_test)
# 若 permdisp_test 的 P 值 < 0.05，说明组间离散度显著不同，PERMANOVA的显著可能由离散度差异引起

# 可选：绘制箱线图查看离散度
boxplot(dispersal_result)

#提取P值
p_value <- paste0("PERMANOVA P = ",permanova_result$`Pr(>F)`[1])
p_disp_value <- paste0("PERMDISP P = ",permdisp_test$tab$`Pr(>F)`[1])
#PCA图添加p值
p2+annotate("text", x = Inf, y = Inf, 
            label =  paste(p_value, p_disp_value, sep = "\n"), 
            hjust = 1.1, vjust = 1.1, size = 5, 
            color = "black", fontface = "bold")

