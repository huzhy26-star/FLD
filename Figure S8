GO_Ccl2 <- read.csv("/data02/huzhiyang_03/FLD/result/16.HSC/cluster_feature/GO_HSC-Ccl2.csv",header = T, row.names = 1 ) %>% filter(ONTOLOGY == "BP")
GO_Wt1 <- read.csv("/data02/huzhiyang_03/FLD/result/16.HSC/cluster_feature/GO_HSC-Wt1.csv",header = T, row.names = 1 ) %>% filter(ONTOLOGY == "BP")


Ebf1_pathway <- GO_Serpina1e  %>% mutate(logq = -log10(qvalue) ) %>% #arrange(desc(Count),desc(logq)) %>% 
  top_n(n = 10,wt = logq) %>% mutate(group = "HSC-Ebf1")
Ccl2_pathway <- GO_Ccl2  %>% mutate(logq = -log10(qvalue) ) %>% #arrange(desc(Count),desc(logq)) %>% 
  top_n(n = 10,wt = logq) %>% mutate(group = "HSC-Ccl2")
Wt1_pathway <- GO_Wt1  %>% mutate(logq = -log10(qvalue) ) %>% #arrange(desc(Count),desc(logq)) %>% 
