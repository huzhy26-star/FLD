df_pathway$unique_id <- factor(df_pathway$unique_id,levels = rev(df_pathway$unique_id))

p <- ggplot(data=df_pathway,aes(x = logq,y = unique_id,fill=group))  +  #fill=PValue，根据PValue填充颜色；color=PValue根据PValue改变线的颜色  
