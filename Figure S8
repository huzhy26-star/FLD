gl_1 <- c("Plin2", "Plin5", "Pnpla2", "Abhd5", "Fabp1", "Rarb", "Rara", "Lrat", "Rbp4", "Dgat1")
gl_1 <- c("Acta2", "Igfbp5", "Igfbp6" , "S100a6", "Krt19", "Ccl2", "Cxcl1","Cxcl12", "Col1a2", "Col3a1", "Col5a2")

HSC <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/核测序/HSC_16.rds")
obj <- AddModuleScore(HSC , gl_1, name = "Cluster")
colnames(obj@meta.data)[(ncol(obj@meta.data)-length(gl_1)+1):ncol(obj@meta.data)] <- names(gl_1)
for (pathway in names(gl_1)) {
  dat_p <- obj@meta.data %>% # filter(time %in% c("0w","4w","8w")) %>% 
    dplyr::select(c(group = subtype_new, score = pathway))
  
  sort_cell <- dat_p %>%
    group_by(group) %>% summarise(mean = mean(score)) %>%
    arrange(desc(mean)) %>% pull(group)
  dat_p$group <- factor(dat_p$group, levels = sort_cell)
  
  p_list[[pathway]] <- ggplot(dat_p, aes_string(x = "group",y = "score" ,fill = "group"))+
    geom_boxplot(outliers = FALSE)+
    scale_fill_manual(values=c(mycolor_new))+ 
    guides(fill=FALSE) +
    stat_summary(fun.data = mean_fun, geom = "text", size=3 , color="black") +
    labs(title = pathway,
         x = '',
         y = '') +
    theme_classic(base_line_size = 0.5)+
    theme(plot.title = element_text(size = 12,colour = "black",hjust = 0.5),
          legend.title = element_text(color="black", 
                                      size=10, face="bold"),
          legend.text = element_text(color="black", 
