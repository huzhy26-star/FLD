obj <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/核测序/Kupffer_16_harmony.rds")
obj <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/核测序/HSC_16.rds")

gene <-c("Mmp1b","Mmp2","Mmp3","Mmp7","Mmp8","Mmp9","Mmp10","Mmp11","Mmp12","Mmp13","Mmp14","Mmp15","Mmp16",
         "Mmp17","Mmp19","Mmp20","Mmp21","Mmp23","Mmp24","Mmp25","Mmp27","Mmp28")
genelist_name <- "Mmp_family"


colnames_matrix <- c('0w','4w',"8w","16w") 
matrix_mean1<- matrix(nrow =length(gene) ,ncol =length(colnames_matrix),
                      dimnames = list(gene,colnames_matrix))
df <- obj@meta.data
for (cur_gene in gene ) {
  for (cur_group in colnames_matrix) {
    if (cur_gene %in% rownames(obj)) {
      df[[cur_gene]] <- obj@assays$RNA@data[cur_gene,]
      a <- subset(df, time == cur_group)
      b<- mean(a[[cur_gene]])
      matrix_mean1[cur_gene,cur_group] <- b
    }else{
      print(glue('{cur_gene}_not_in_countmatrix'))
    }
  }
}
scaled_mat <- scale(t(matrix_mean1), center=TRUE, scale=TRUE)
scaled_mat <- as.data.frame(t(scaled_mat))

scaled_mat <- matrix_mean1
scaled_mat$gene <- rownames(scaled_mat)
matrix_mean1 <- arrange(scaled_mat,desc(Mature))
rownames(matrix_mean1) <- matrix_mean1$gene
matrix_mean1 <- matrix_mean1[,-4]

annotation_row <- data.frame(
  genelist_name = rep(genelist_name,length(gene)))
rownames(annotation_row) <- rownames(matrix_mean1)

