          axis.text.x = element_text(size = 10,  
                                     color = "black",
                                     face = "bold", 
                                     vjust = 1,
                                     hjust = 0.95,
                                     angle = 45), 
          axis.text.y = element_text(size = 10,  color = "black",face = "bold", vjust = 0.5,
                                     hjust = 0.5, angle = 0))
}




