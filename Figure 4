df_bulk_816w <- bulk_df1 %>% dplyr::select(df_group_816w$samplename)
df_bulk_816w <- log(df_bulk_816w+1)
#设置分组信息
group_list <- factor(df_group_816w[,2],ordered = F)
design <- model.matrix(~0+group_list)
colnames(design) <- levels(group_list)
rownames(design) <- colnames(df_bulk_816w)
design
#线性模型拟合
fit <- lmFit(df_bulk_816w, design)
#构建比较矩阵
cont.matrix <- makeContrasts(contrasts = "G16w-G8w",levels = design)
cont.matrix

fit2 <- contrasts.fit(fit,cont.matrix) # 构建数据线性模型,计算估计的相关系数和标准差
fit2 <- eBayes(fit2) # 贝叶斯检验
tmpOut <- topTable(fit2,coef = 1,n = Inf,adjust.method = "BH",sort.by = "logFC") # 结果
dif <- tmpOut[tmpOut$P.Value <= 0.05 & abs(tmpOut$logFC) > 0,]
dim(dif)


DEG <- tmpOut
