bulk_df1 <- read.csv("~/fatty_liver_hzy/bulk_data/liver_bulk.csv",header = T,row.names = 1,check.names = F)
df_group <- read.csv("~/fatty_liver_hzy/bulk_data/liver_bulk_group.csv",header = T,row.names = 1)
