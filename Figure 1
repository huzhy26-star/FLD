df_merge <- readxl::read_xlsx("/data02/huzhiyang_03/FLD/实验数据/SiriusRed.xlsx",sheet = "WD")
df_plot <- reshape2::melt(df_merge)
colnames(df_plot) <- c("time","score")

df_plot$time <- factor(df_plot$time,levels = c("0w","4w","8w","12w","16w","20w","24w","36w"))
df_plot1 <- df_plot %>%
  group_by(time) %>%
  summarize(Value = mean(score), SD = sd(score), .groups = "drop")
df_plot1$time <- factor(df_plot1$time,levels = c("0w","4w","8w","12w","16w","20w","24w","36w"))
comparisons = list(c("0w","4w"),c("4w","8w"),c("8w","12w"),c("12w","16w"),
                   c("16w","20w"),c("20w","24w"),c("24w","36w"))

p1 <- ggplot(data =df_plot , aes(x = time, y = score)) +
  geom_bar(data =df_plot1, aes(x = time, y = Value, fill = time),
           stat = "identity", width = 0.8, alpha = 0.6) +
  geom_errorbar(data = df_plot1, aes(x = time, y = Value,ymin = Value - SD, ymax = Value + SD),
                width = 0.2, size = 0.8, color = "black") +
  geom_jitter(data = df_plot, aes(x = time, y = score, color = time),
              width = 0.2, size = 2, alpha = 0.8) + 
  stat_compare_means(comparisons=comparisons,label="p.format",method = 'wilcox.test',
                     symnum.args=list(cutpoints = c(0, 0.0001, 0.001, 0.01, 0.05, 1.01),
                                      symbols = c("****", "***", "**", "*", "ns")),
                     label.y = c(9, 12, 15, 18, 21, 24, 27, 30)) +
  labs(title = "Sirius Red",
       x = "",
       y = "positive area (%)") +
  scale_fill_manual(values = FLD_col) + 
  scale_color_manual(values = FLD_col)+ 
  theme(
    plot.title    = element_text(color = 'black', size   = 10, hjust = 0.5,face = "bold"),
    axis.text.x   = element_text(color = 'black', size = 8, angle = 0,hjust = 0.5,face = "bold"),#
    axis.text.y   = element_text(color = 'black', size = 8, angle = 0),
    axis.title.x  = element_text(color = 'black', size = 14, angle = 0),
    axis.title.y  = element_text(color = 'black', size = 14, angle = 90),
    panel.background=element_rect(fill="white"), 
    legend.position = "none",
    panel.border = element_rect(linetype = 'solid', size = 0.5,fill = NA) 
  )
p1
save_plot(p1, "/data02/huzhiyang_03/FLD/result/33.实验数据/SiriusRed_WD",if_pdf = T,width = 6,height = 4)


