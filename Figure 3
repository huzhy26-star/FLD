p <- ggplot(df, aes(x = reorder(gene, avg_log2FC), y = avg_log2FC)) +
  geom_segment(aes(xend = gene, yend = 0), color = "grey70", size = 0.8) +
  geom_point(aes(color = avg_log2FC > 0, size = abs(avg_log2FC))) +
  coord_flip() + 
  scale_color_manual(values = c("TRUE" = "#d95f02", "FALSE" = "#7570b3"), 
                     labels = c("TRUE" = "Up", "FALSE" = "Down"),
                     name = "Direction") +
  theme_classic(base_line_size = 0.5)+# 主题设置，这个是无线条主题 # 坐标轴的粗细
  cowplot::panel_border(size = 0.5,color = "black") +
  theme(plot.title = element_text(size = 10,colour = "black",hjust = 0.5),
        legend.title = element_text(color="black", # 修改图例的标题
                                    size=10, face="plain"),
        legend.text = element_text(color="black", # 设置图例标签文字
                                   size = 10, face = "plain"),
        axis.text.x = element_text(size = 10,  # 修改X轴上字体大小，
                                   color = "black", # 颜色
                                   face = "plain", #  face取值：plain普通，bold加粗，italic斜体，bold.italic斜体加粗
                                   vjust = 0.5, # 位置
                                   hjust = 0.5,
                                   angle = 0), #角度
        axis.text.y = element_text(size = 10,  color = "black",face = "plain", vjust = 0.5,
                                   hjust = 0.5, angle = 0))+
  labs(x = NULL, y = "log2 Fold Change (8w vs 4w)", 
       title = "Expression of Pro-inflammatory genes (Mac & monoKC)")
