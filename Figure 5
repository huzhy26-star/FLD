#### 合并cellchat对象
select_col <- c("SubCellType") #"SubCellType" "Cellgroup"MajorCellType
comparisons <- combn(c("16w","24w"), 2, simplify = F)


for (i in 1:length(comparisons)) {
  select_group <- comparisons[[i]]
  group_1 <- select_group[1]
  group_2 <- select_group[2]
  for (cur_col in select_col) {
    out_dir <- glue("/data02/huzhiyang_03/FLD/result/06.细胞互作分析/合并测序/{group_2}")
    cco_1 <- readRDS(glue("/data02/huzhiyang_03/FLD/result/06.细胞互作分析/合并测序/{select_col}/cellchat_{group_1}_cohep.rds"))
    cco_2 <- readRDS(glue("/data02/huzhiyang_03/FLD/result/06.细胞互作分析/合并测序/{select_col}/cellchat_{group_2}_cohep.rds"))
    cat("The cell identities in single cell interaction", group_1, ":", levels(cco_1@idents), "\n\n")
    cat("The cell identities in single cell interaction", group_2, ":", levels(cco_2@idents), "\n\n")
    
    common_celltypes <- intersect(levels(cco_1@idents), levels(cco_2@idents))
    cco_1_aligned <- subsetCellChat(cco_1, idents.use = common_celltypes)
    cco_2_aligned <- subsetCellChat(cco_2, idents.use = common_celltypes)
    
    cco.list <- list(cco_1_aligned, cco_2_aligned)
    names(cco.list) <- select_group
    
    cellchat <- CellChat::mergeCellChat(cco.list, add.names = names(cco.list), merge.data = TRUE)
    
    saveRDS(cellchat, glue("{out_dir}/Merged_cellchat_{group_1}_{group_2}_{cur_col}_cohep.rds"))
    save(cco.list, cellchat, file = glue("{out_dir}/Merged_cellchat_{group_1}_{group_2}_{cur_col}_cohep.Rdata"))
  }
}

