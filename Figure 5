obj_ST@meta.data$subtype <- ifelse(is.na(obj_ST@meta.data$subtype), obj_ST@meta.data$celltype, obj_ST@meta.data$subtype)

remaining_types <- c("B_cell","Cholangiocyte","Endothelial","Hepatocyte","HSC","Myeloid")
specified_types <- c("CD8T")

results_list <- vector("list", length(specified_types))
names(results_list) <- specified_types

all_cell_coords <- obj_ST@meta.data[, c("row", "col")]
all_cell_types <- obj_ST@meta.data$subtype

for (spec_type in specified_types) {
  print(spec_type)
  
  specified_cells <- which(all_cell_types == spec_type)
  specified_names <- rownames(obj_ST@meta.data)[specified_cells]
  specified_coords <- all_cell_coords[specified_cells, ]

  type_results <- vector("list", length(remaining_types))
  
  for (j in seq_along(remaining_types)) {
    remain_type <- remaining_types[j]
    remaining_cells <- which(all_cell_types == remain_type)
    
    if (length(specified_cells) > 0 && length(remaining_cells) > 0) {
      remaining_coords <- all_cell_coords[remaining_cells, ]

      min_dists <- sapply(1:nrow(specified_coords), function(i) {
        min(sqrt((specified_coords[i, 1] - remaining_coords[, 1])^2 +   ##平均 或 最小距离
                   (specified_coords[i, 2] - remaining_coords[, 2])^2))
      })
      
      type_results[[j]] <- data.frame(
        cell = specified_names,
        min_distance = min_dists,
        source_type = spec_type,
        target_type = remain_type
      )
    }
  }
  
  results_list[[spec_type]] <- do.call(rbind, type_results)
}

