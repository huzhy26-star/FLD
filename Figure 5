hep <- readRDS("/data02/huzhiyang_03/FLD/RDS_file/核测序/Hepatocyte_16.rds")

final_df <- data.frame()
for (gene in  c("Fas","F2r","F2rl1","F2rl2","Pard3")) {
  gene_data <- hep %>% 
    FetchData( vars = c(gene, "time")) %>% setnames(c(1,2), c("exp","group")) %>%    #####修改细胞类型的变量
    dplyr::select(exp, group)
  
  df <- gene_data %>% group_by(group) %>% summarise(pct = PercentAbove(exp, threshold = 0), exp = mean(exp)) %>% 
    unique() %>% mutate(genename = gene)
  final_df <- rbind(final_df,df)
}

